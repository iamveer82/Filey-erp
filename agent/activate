#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Filey dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `filey` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-filey-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `filey pm
# install` and `filey update` keep that check.
# ============================================================================
_FILEY_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_filey_test_env="--test-environment"
_filey_expect_extras=""
for _filey_arg in "$@"; do
    if [ -n "$_filey_expect_extras" ]; then
        _filey_test_env="--test-environment=$_filey_arg"
        _filey_expect_extras=""
        continue
    fi
    case "$_filey_arg" in
        --) break ;;
        --test-extras) _filey_expect_extras=1 ;;
        --test-extras=*) _filey_test_env="--test-environment=${_filey_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_filey_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _filey_arg _filey_test_env _filey_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _filey_arg _filey_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_FILEY_REPO/scripts/_activation.sh"

if ! filey_sync "$_FILEY_REPO" "$_filey_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _filey_test_env
    return 1 2>/dev/null || exit 1
fi
unset _filey_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __FILEY_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_filey_script="$(filey_compose_env "$_FILEY_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _filey_script
    return 1 2>/dev/null || exit 1
}
_filey_keys="$(printf '%s\n' "$_filey_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __FILEY_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__FILEY_SAVED_PATH="$PATH"
for _filey_k in $_filey_keys; do
    eval "__FILEY_SAVED_$_filey_k=\"\${$_filey_k+set}\""
    eval "__FILEY_PRIOR_$_filey_k=\${$_filey_k-__FILEY_UNSET__}"
done
filey_apply_env "$_filey_script"

# This checkout, not whichever `filey` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__FILEY_WORKTREE="$_FILEY_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__FILEY_WORKTREE_NAME="$(git -C "$_FILEY_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__FILEY_WORKTREE_NAME" ] || [ "$__FILEY_WORKTREE_NAME" = HEAD ]; then
    __FILEY_WORKTREE_NAME="$(basename "$_FILEY_REPO")"
fi
__FILEY_SAVED_PS1="${PS1-__FILEY_UNSET__}"
__FILEY_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__FILEY_UNSET__}"

_filey_worktree_here() {
    _filey_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_filey_top" && pwd -P)" = "$(cd "$__FILEY_WORKTREE" && pwd -P)" ]
}

filey() {
    _filey_worktree_here || {
        printf '%s\n' "filey: $(pwd) is outside $__FILEY_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__FILEY_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" filey "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe filey "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python filey "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe filey "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python filey "$@"
        else
            exec python filey "$@"
        fi
    )
}

_filey_prompt() {
    if [ "$__FILEY_SAVED_PS1" = "__FILEY_UNSET__" ]; then
        _filey_base_ps1=""
    else
        _filey_base_ps1="$__FILEY_SAVED_PS1"
    fi
    if _filey_worktree_here; then
        PS1="($__FILEY_WORKTREE_NAME) $_filey_base_ps1"
    else
        PS1="$_filey_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_filey_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_filey_prompt
fi
_filey_prompt

deactivate() {
    export PATH="$__FILEY_SAVED_PATH"
    for _filey_k in $__FILEY_KEY_LIST; do
        eval "_filey_was=\"\$__FILEY_SAVED_$_filey_k\""
        eval "_filey_old=\"\$__FILEY_PRIOR_$_filey_k\""
        if [ "$_filey_was" != "set" ]; then
            unset "$_filey_k"
        else
            export "$_filey_k=$_filey_old"
        fi
        unset "__FILEY_SAVED_$_filey_k" "__FILEY_PRIOR_$_filey_k"
    done
    if [ "$__FILEY_SAVED_PS1" = "__FILEY_UNSET__" ]; then
        unset PS1
    else
        PS1="$__FILEY_SAVED_PS1"
    fi
    if [ "$__FILEY_SAVED_PROMPT_COMMAND" = "__FILEY_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__FILEY_SAVED_PROMPT_COMMAND"
    fi
    unset __FILEY_SAVED_PATH __FILEY_KEY_LIST __FILEY_ACTIVATED \
          __FILEY_WORKTREE __FILEY_WORKTREE_NAME \
          __FILEY_SAVED_PS1 __FILEY_SAVED_PROMPT_COMMAND
    unset -f deactivate filey _filey_worktree_here _filey_prompt
    unset _filey_k _filey_was _filey_old _filey_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__FILEY_KEY_LIST="$_filey_keys"

# The composition library is not part of the user's shell.
unset -f filey_sync filey_bootstrap_python filey_compose_env filey_apply_env \
         filey_activation_current filey_ensure_env
unset _FILEY_REPO _filey_script _filey_keys _filey_k _filey_top

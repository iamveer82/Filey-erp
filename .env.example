# Filey ERP — Environment Variables
# 
# 1. Create a project at https://supabase.com
# 2. Project Settings → API → copy the values below
# 3. Copy this file to `.env` and fill them in
# 4. Run supabase/schema.sql in the Supabase SQL Editor
# 5. In Authentication → Providers → Email, enable email sign-in

# ── Required: Supabase connection ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional: Hosted invoice portal ──
# Public HTTPS Filey app URL using the SAME Supabase project. No credentials here.
# Required for recipient links when Filey runs on desktop or localhost.
# Leave blank to use the current public HTTPS app address; local mode shares PDFs.
VITE_PUBLIC_APP_URL=

# ── Optional: Error monitoring (Sentry) ──
# Leave blank to disable. Only active in production builds.
VITE_SENTRY_DSN=

# ── Edge function secrets (set in Supabase Dashboard → Edge Functions → Secrets) ──
# These are NOT in .env — they are server-side secrets set directly in Supabase:
#   DODO_PAYMENTS_API_KEY      — Dodo Payments API key (sells both plans)
#   DODO_PAYMENTS_WEBHOOK_KEY  — Dodo webhook signing secret (whsec_...)
#   DODO_PAYMENTS_ENVIRONMENT  — test_mode | live_mode (defaults to test_mode when unset)
#   DODO_PRODUCT_FREEDOM       — product id of the one-time Freedom licence
#   DODO_PRODUCT_CLOUD         — product id of the $5/month Cloud subscription
#   DODO_AI_CREDIT_PACKS       — JSON array of AI credit packs for checkout_ai_credits
#   FILEY_AI_OPENROUTER_KEY    — OpenRouter API key for AI credit chat/video (optional if BYOK)
#   STRIPE_SECRET_KEY          — DEPRECATED: Stripe is fully retired; payments run through Dodo
#   STRIPE_WEBHOOK_SECRET      — DEPRECATED: unused
#   STRIPE_PRICE_LITE          — DEPRECATED: unused
#   LICENSE_SIGNING_KEY        — ECDSA P-256 private key (PKCS8 base64) for desktop license signing
#   RESEND_API_KEY             — Resend.com API key for sending email
#   OPENAI_API_KEY             — OpenAI API key for AI agent features
#   SITE_URL                   — Canonical site URL (e.g. https://app.filey.com)
#   SUPABASE_URL               — Injected by Supabase platform (do not set manually)
#   SUPABASE_SERVICE_ROLE_KEY  — Injected by Supabase platform (do not set manually)
# Filey ERP — Environment Variables
# Copy this file to .env and fill in your values

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Function Secrets (set via `supabase secrets set`)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# RESEND_API_KEY=re_...
# OPENAI_API_KEY=sk-...
# SITE_URL=https://app.fileyerp.com

# Tauri Auto-Updater Signing (set in GitHub Secrets)
# TAURI_SIGNING_PRIVATE_KEY=<contents of src-tauri/filey-key>

# Sentry (optional — error monitoring)
# VITE_SENTRY_DSN=https://...@sentry.io/...

# App
VITE_APP_NAME=Filey ERP
VITE_APP_VERSION=0.4.0
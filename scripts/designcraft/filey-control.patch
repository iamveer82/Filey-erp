 /// Wraps the app to read dropped files asynchronously (browsers can't read them synchronously)
 /// and feed them through the inbox.
+/// Filey: the page's control bridge, for a same-origin host (Filey embeds the app in an iframe
+/// and its agent drives it).
+/// - `designcraftControl(method, paramsJson)` runs one control-protocol request and resolves with the
+///   reply as JSON text.
+/// - `designcraftOpen(name, bytes)` opens a file as if it had been dropped on the window.
+fn expose_control(tx: std::sync::mpsc::Sender<ControlRequest>, pending: Pending, opens: Opens, ctx: egui::Context) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let control_ctx = ctx.clone();
+    let control = wasm_bindgen::closure::Closure::<dyn FnMut(String, String) -> js_sys::Promise>::new(move |method: String, params: String| {
+        let params = serde_json::from_str(&params).unwrap_or(serde_json::Value::Null);
+        let mut next = Some(ControlRequest::new(method, params));
+        js_sys::Promise::new(&mut |resolve, _reject| {
+            let Some((req, rx)) = next.take() else { return };
+            if tx.send(req).is_err() {
+                let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(r#"{"ok":false,"error":"Designs is not running"}"#));
+                return;
+            }
+            pending.borrow_mut().push((rx, resolve));
+            control_ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("designcraftControl"), control.as_ref()).map_err(|e| format!("{e:?}"))?;
+    control.forget();
+    let open = wasm_bindgen::closure::Closure::<dyn FnMut(String, Vec<u8>)>::new(move |name: String, bytes: Vec<u8>| {
+        opens.borrow_mut().push((name, bytes));
+        ctx.request_repaint();
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("designcraftOpen"), open.as_ref()).map_err(|e| format!("{e:?}"))?;
+    open.forget();
+    Ok(())
+}

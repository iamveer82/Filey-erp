+/// Filey: the page's control bridge.
+/// - `vectorcraftControl(method, paramsJson)` runs one control-protocol request and resolves with the
+///   reply as JSON text.
+/// - `vectorcraftOpen(name, bytes)` opens a file as if it had been dropped on the window.
+fn expose_control(inbox: Inbox) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let (tx, rx) = std::sync::mpsc::channel::<ControlRequest>();
+    FILEY.with(|f| f.borrow_mut().control_rx = Some(rx));
+    let wake = || FILEY.with(|f| f.borrow().ctx.clone()).map(|c| c.request_repaint());
+    let control = wasm_bindgen::closure::Closure::<dyn FnMut(String, String) -> js_sys::Promise>::new(move |method: String, params: String| {
+        let params = serde_json::from_str(&params).unwrap_or(serde_json::Value::Null);
+        let mut next = Some(ControlRequest::new(method, params));
+        js_sys::Promise::new(&mut |resolve, _reject| {
+            let Some((req, rx)) = next.take() else { return };
+            if tx.send(req).is_err() {
+                let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(r#"{"ok":false,"error":"Vector is not running"}"#));
+                return;
+            }
+            FILEY.with(|f| f.borrow_mut().pending.push((rx, resolve)));
+            wake();
+        })
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("vectorcraftControl"), control.as_ref()).map_err(|e| format!("{e:?}"))?;
+    control.forget();
+    let open = wasm_bindgen::closure::Closure::<dyn FnMut(String, Vec<u8>)>::new(move |name: String, bytes: Vec<u8>| {
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes));
+        wake();
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("vectorcraftOpen"), open.as_ref()).map_err(|e| format!("{e:?}"))?;
+    open.forget();
+    Ok(())
+}

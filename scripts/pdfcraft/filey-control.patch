+/// A browser build has no clock or time zone of its own: dynamic stamps read "at 12:00 am,
+/// Jan 00, 0", and comments and saves carry no date. The page's clock and zone stand in.
+fn new_session() -> Session {
+    #[cfg(target_arch = "wasm32")]
+    return Session::new().with_wall_clock(
+        || (js_sys::Date::now() / 1000.0) as i64,
+        || -(js_sys::Date::new_0().get_timezone_offset() as i64) * 60,
+    );
+    #[cfg(not(target_arch = "wasm32"))]
+    Session::new()
+}

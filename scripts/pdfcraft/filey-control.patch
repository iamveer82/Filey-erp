+/// Filey: the control bridge for a same-origin host (the Filey app embeds PdfCraft in an iframe
+/// and its agent drives it). `pdfcraftControl(method, paramsJson)` runs one UI control request
+/// (`crates/ui-egui/src/control.rs`: `ui.state`, `ui.commands`, `ui.command`, `ui.inspect`,
+/// `ui.click`, `ui.type`, `ui.key`, `ui.set`, `ui.screenshot`, …) and resolves with
+/// `{"ok":true,"result":…}` or `{"ok":false,"error":"…"}` as JSON text. Files go in and out
+/// through the `?host=parent` bridge above.
+#[cfg(target_arch = "wasm32")]
+mod filey {
+    use std::cell::RefCell;
+    use std::rc::Rc;
+
+    use eframe::wasm_bindgen::{JsValue, closure::Closure};
+    use pdfcraft_ui_egui::PdfCraftApp;
+    use pdfcraft_ui_egui::control::{ControlClient, Reply};
+
+    pub type Pending = Rc<RefCell<Vec<(std::sync::mpsc::Receiver<Reply>, js_sys::Function)>>>;
+
+    /// PdfCraft plus the replies it owes the host, handed over after each frame's logic.
+    pub struct Shell {
+        pub app: PdfCraftApp,
+        pub pending: Pending,
+    }
+
+    impl eframe::App for Shell {
+        fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+            self.app.raw_input_hook(ctx, raw);
+        }
+
+        fn save(&mut self, storage: &mut dyn eframe::Storage) {
+            self.app.save(storage);
+        }
+
+        fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+            self.app.logic(ctx, frame);
+            let mut pending = self.pending.borrow_mut();
+            pending.retain(|(rx, resolve)| {
+                let reply = match rx.try_recv() {
+                    Ok(Ok(result)) => serde_json::json!({"ok": true, "result": result}),
+                    Ok(Err(error)) => serde_json::json!({"ok": false, "error": error}),
+                    Err(std::sync::mpsc::TryRecvError::Empty) => return true,
+                    Err(std::sync::mpsc::TryRecvError::Disconnected) => serde_json::json!({"ok": false, "error": "the request was dropped"}),
+                };
+                let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(&reply.to_string()));
+                false
+            });
+            if !pending.is_empty() {
+                ctx.request_repaint();
+            }
+        }
+
+        fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+            self.app.ui(ui, frame);
+        }
+    }
+
+    pub fn expose_control(client: ControlClient, pending: Pending) -> Result<(), String> {
+        let window = web_sys::window().ok_or("no window")?;
+        let control = Closure::<dyn FnMut(String, String) -> js_sys::Promise>::new(move |method: String, params: String| {
+            let params = serde_json::from_str(&params).unwrap_or(serde_json::Value::Object(Default::default()));
+            let rx = client.send(&method, params);
+            let mut next = Some(rx);
+            js_sys::Promise::new(&mut |resolve, _reject| {
+                if let Some(rx) = next.take() {
+                    pending.borrow_mut().push((rx, resolve));
+                }
+            })
+        });
+        js_sys::Reflect::set(&window, &JsValue::from_str("pdfcraftControl"), control.as_ref()).map_err(|e| format!("{e:?}"))?;
+        control.forget();
+        Ok(())
+    }
+}

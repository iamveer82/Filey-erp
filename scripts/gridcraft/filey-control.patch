+/// Filey: the page's control bridge, for a same-origin host (the Filey app embeds GridCraft in an
+/// iframe and its agent drives it).
+/// - `gridcraftControl(method, paramsJson)` runs one control-protocol request
+///   (docs/control-protocol.md: `engine.execute`, `engine.commands`, `document.inspect`,
+///   `sheet.read`, `cell.get`, `ui.*`) and resolves with the reply as JSON text, as the desktop
+///   app's control port answers.
+/// - `gridcraftOpen(name, bytes)` opens a file as if it had been dropped on the window.
+fn expose_control(tx: std::sync::mpsc::Sender<ControlRequest>, pending: Pending, inbox: Inbox, ctx: egui::Context) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let control_ctx = ctx.clone();
+    let control = wasm_bindgen::closure::Closure::<dyn FnMut(String, String) -> js_sys::Promise>::new(move |method: String, params: String| {
+        let params = serde_json::from_str(&params).unwrap_or(serde_json::Value::Null);
+        let mut next = Some(ControlRequest::new(method, params));
+        js_sys::Promise::new(&mut |resolve, _reject| {
+            let Some((req, rx)) = next.take() else { return };
+            if tx.send(req).is_err() {
+                let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(r#"{"ok":false,"error":"Sheets is not running"}"#));
+                return;
+            }
+            pending.borrow_mut().push((rx, resolve));
+            control_ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("gridcraftControl"), control.as_ref()).map_err(|e| format!("{e:?}"))?;
+    control.forget();
+    let open = wasm_bindgen::closure::Closure::<dyn FnMut(String, Vec<u8>)>::new(move |name: String, bytes: Vec<u8>| {
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes));
+        ctx.request_repaint();
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("gridcraftOpen"), open.as_ref()).map_err(|e| format!("{e:?}"))?;
+    open.forget();
+    Ok(())
+}

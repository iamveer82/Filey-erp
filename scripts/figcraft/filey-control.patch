+        // The app answered during its frame (screenshots a few frames later); resolve each promise.
+        let mut bridge = self.bridge.borrow_mut();
+        bridge.waiting.retain(|(rx, resolve)| {
+            let reply = match rx.try_recv() {
+                Ok(ControlReply { result: Ok(v), .. }) => serde_json::json!({"ok": true, "result": v}),
+                Ok(ControlReply { result: Err(e), .. }) => serde_json::json!({"ok": false, "error": e}),
+                Err(std::sync::mpsc::TryRecvError::Empty) => return true,
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => serde_json::json!({"ok": false, "error": "the request was dropped"}),
+            };
+            let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(&reply.to_string()));
+            false
+        });
+        if !bridge.waiting.is_empty() {
+            ui.ctx().request_repaint();
+        }
     }
 }
 
+/// Filey: the page's control bridge.
+/// - `figcraftControl(method, paramsJson)` runs one control-channel request (see crates/ui-egui/src/control.rs)
+///   and resolves with `{ok, result}` or `{ok: false, error}` as JSON text.
+/// - `figcraftOpen(name, bytes)` opens a file as if it had been dropped on the window.
+fn expose_control(bridge: Bridge, ctx: egui::Context) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let (control_bridge, control_ctx) = (bridge.clone(), ctx.clone());
+    let control = wasm_bindgen::closure::Closure::<dyn FnMut(String, String) -> js_sys::Promise>::new(move |method: String, params: String| {
+        let params = serde_json::from_str(&params).unwrap_or(serde_json::Value::Null);
+        let mut next = Some((method, params));
+        let (bridge, ctx) = (control_bridge.clone(), control_ctx.clone());
+        js_sys::Promise::new(&mut |resolve, _reject| {
+            let Some((method, params)) = next.take() else { return };
+            bridge.borrow_mut().submit.push((method, params, resolve));
+            ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("figcraftControl"), control.as_ref()).map_err(|e| format!("{e:?}"))?;
+    control.forget();
+    let open = wasm_bindgen::closure::Closure::<dyn FnMut(String, Vec<u8>)>::new(move |name: String, bytes: Vec<u8>| {
+        bridge.borrow_mut().opens.push((name, bytes));
+        ctx.request_repaint();
+    });
+    js_sys::Reflect::set(&window, &JsValue::from_str("figcraftOpen"), open.as_ref()).map_err(|e| format!("{e:?}"))?;
+    open.forget();
+    Ok(())
+}

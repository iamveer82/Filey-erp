     // `FigApp::ui` runs its own per-frame logic first (fonts, theme), like the desktop app.
     fn ui(&mut self, ui: &mut egui::Ui, _frame: &mut eframe::Frame) {
+        let mut bridge = self.bridge.borrow_mut();
+        for (method, params, resolve) in std::mem::take(&mut bridge.submit) {
+            let (tx, rx) = std::sync::mpsc::channel();
+            self.fig.control_queue.push(ControlRequest { id: serde_json::Value::Null, method, params, reply: tx, cancelled: Default::default() });
+            bridge.waiting.push((rx, resolve));
+        }

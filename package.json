{
  "name": "filey-erp",
  "private": true,
  "version": "3.0.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "cap:sync": "npm run build && cap sync",
    "capacitor:update:after": "node scripts/fix-mobile-ios-paths.mjs",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "build:android": "npm run build && cap sync android && node scripts/build-mobile-android.mjs",
    "build:ios": "npm run build && cap sync ios && xcodebuild -project mobile/ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" -derivedDataPath mobile/ios/build CODE_SIGNING_ALLOWED=NO build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node scripts/rls-test.mjs",
    "test:rls:local": "node scripts/test-rls-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "setup": "npm run tauri build && npm run shortcut",
    "test:browser:tools": "node scripts/test-browser-tools.mjs",
    "test:edge": "deno test --node-modules-dir=none --allow-env --allow-net --allow-read --lock=deno.lock --frozen supabase/functions"
  },

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "sms:*" }] },
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "updater:default",
    "process:default"
  ]
}
